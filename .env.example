# Copy to .env.local and fill in. Server-only values: never prefix with NEXT_PUBLIC_.

# Repository implementation: "mock" (local .data/fichas.json) or "sheets" (Google Apps Script).
FICHA_REPOSITORY=mock

# Optional: override the mock storage file (default: .data/fichas.json)
# FICHA_REPOSITORY_PATH=

# Google Apps Script web app URL (ends with /exec) and the token printed by setup()
APPS_SCRIPT_URL=
APPS_SCRIPT_TOKEN=

# Optional: Apps Script request timeout in ms (default 15000)
# APPS_SCRIPT_TIMEOUT_MS=
